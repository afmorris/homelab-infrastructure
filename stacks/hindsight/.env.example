# Paste these into the Portainer stack's "Environment variables" section.
# All three live in 1Password (Home vault, item "Hindsight"), one field each.
# Make each with: openssl rand -hex 32
HINDSIGHT_DB_PASSWORD=
# What Claude Code sends as "Authorization: Bearer ..." (field "API key").
HINDSIGHT_API_KEY=
# What you type to open the web console (field "Console key").
HINDSIGHT_CONSOLE_KEY=
