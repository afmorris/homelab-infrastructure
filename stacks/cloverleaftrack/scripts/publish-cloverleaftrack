#!/usr/bin/env bash
# Publish CloverleafTrack right now: deploy the newest image, then export the static site to S3.
#   1. ~/deploy-cloverleaftrack  pulls :latest and recreates the container if the image changed (rolls back if unhealthy)
#   2. ~/ctf                     crawls the container with wget and syncs to s3://cloverleaftrack.com
# If the deploy fails (including a rollback), the export is skipped so a broken site is never published.
# The same two steps also run separately from cron (02:30 deploy, 03:00 export), so this is only for same-day publishes.
set -euo pipefail

log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] publish: $*" >&2; }

log "Step 1/2: deploy"
if ! /home/tony/deploy-cloverleaftrack; then
  log "Deploy failed or was rolled back. Not exporting. See ~/logs/deploy-cloverleaftrack.log"
  exit 1
fi

log "Step 2/2: export to S3 (takes about 4 minutes)"
set +e   # grep exits 1 when nothing matches; read ctf's own exit status from PIPESTATUS instead
/home/tony/ctf 2>&1 | tee -a /home/tony/logs/ctf.log | grep -E "^\[20|ERROR|WARNING"
rc=${PIPESTATUS[0]}
set -e
if [[ "$rc" -ne 0 ]]; then
  log "Export failed (exit $rc). See ~/logs/ctf.log and ~/logs/cloverleaf-generation.log"
  exit "$rc"
fi

log "Done. cloverleaftrack.com now serves the latest image's pages."
