# Copy to /mnt/storage0/apps/icloud-backup/icloud-backup.env on TrueNAS
# (chmod 600). Generate each value with:  openssl rand -base64 32
# Store all three in the password manager as "iCloud backup (TrueNAS)".

# Password for the web UI at http://truenas:30880
AUTH_PASSWORD=change-me

# Signs web UI session cookies
SECRET_KEY=change-me

# Encrypts the Apple ID passwords the app stores in /config.
# If this is lost, every Apple ID has to be added again.
ICLOUD_SECRET_KEY=change-me
